# Postgres (used by db service)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# Backend (used by backend service)
# NOTE:
# - When running with Docker Compose, the DB host should be `db`
# - When running locally without Docker, change `db` to `localhost`
DATABASE_URL=postgresql://your_db_user:your_db_password@db:5432/your_db_name

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
